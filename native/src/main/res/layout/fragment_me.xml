<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="18dp">

            <TextView
                android:id="@+id/tvUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#FFFFC857"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvPoints"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/accent_soft"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvWatch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSign"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:text="@string/points_sign"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnInvite"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip"
                    android:gravity="center"
                    android:text="@string/points_invite"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/btnHistory"
            style="@style/AIStream.Row"
            android:layout_marginTop="16dp"
            android:text="@string/me_history" />

        <TextView
            android:id="@+id/btnRedeem"
            style="@style/AIStream.Row"
            android:layout_marginTop="10dp"
            android:text="@string/points_redeem" />

        <TextView
            android:id="@+id/btnChangePw"
            style="@style/AIStream.Row"
            android:layout_marginTop="10dp"
            android:text="@string/act_change_pw" />

        <TextView
            android:id="@+id/btnLogout"
            style="@style/AIStream.Row"
            android:layout_marginTop="10dp"
            android:text="@string/act_logout"
            android:textColor="@color/danger" />

    </LinearLayout>

</ScrollView>
