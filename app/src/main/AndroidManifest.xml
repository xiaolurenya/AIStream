<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 用户站点大多是内网 http 地址，必须允许明文流量 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AIStream">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 填地址/密码的页锁竖屏，免得弹输入法时来回转 -->
        <activity
            android:name=".ServerSetupActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />

        <!-- sensorUser：跟随手机「自动旋转」开关，用户开了就能横屏看；
             播放全屏时代码再强制切横屏（覆盖系统锁定），右上角 ⚙ 里也能手动切 -->
        <activity
            android:name=".WebActivity"
            android:exported="false"
            android:screenOrientation="sensorUser"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize" />
    </application>
</manifest>
