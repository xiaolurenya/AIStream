<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 站点本身是深色界面，APP 一律锁深色，避免 DayNight 在白天把窗口刷成白底 -->
    <style name="Theme.AIStream" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColor">@color/fg</item>
        <item name="android:textColorHint">#5a6270</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/accent_soft</item>
        <item name="colorControlNormal">@color/field</item>
        <item name="colorControlActivated">@color/accent_soft</item>
    </style>
</resources>
