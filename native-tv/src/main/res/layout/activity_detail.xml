<?xml version="1.0" encoding="utf-8"?>
<!-- 外层 FrameLayout 为了盖「正在优化加载线路」遮罩：官方 + 采集都到位再渲染，不闪 360zy -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- 海报背景：播放前的选集区也透出本片海报（磨砂），不再是一块死蓝底 -->
    <ImageView
        android:id="@+id/ivBackdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B30C1F3F" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="36dp"
        android:paddingTop="24dp"
        android:paddingEnd="36dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="200dp"
                android:layout_height="290dp"
                android:background="@drawable/bg_card">

                <ImageView
                    android:id="@+id/imgPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/app_name"
                    android:scaleType="centerCrop" />

            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="26dp"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/fg"
                    android:textSize="26sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPlay"
                        style="@style/AIStream.FocusItem"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_btn"
                        android:gravity="center"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="@string/play_now"
                        android:textColor="@android:color/white"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btnFav"
                        style="@style/AIStream.FocusItem"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="☆ 收藏"
                        android:textColor="@color/fg_dim"
                        android:textSize="17sp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/tvPlot"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/fg_dim"
                    android:textSize="14sp" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/labLines"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/label_line"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/labEps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_episodes"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false" />

    </LinearLayout>

    </ScrollView>

    <!-- 加载遮罩：倒计时 + 已找到线路数 + 立即播放（遥控器确认键直接播） -->
    <LinearLayout
        android:id="@+id/loadOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="正在优化加载线路"
            android:textColor="@color/fg"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLoadCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/accent_soft"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvLoadInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/fg_dim"
            android:textSize="15sp" />

        <ProgressBar
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginTop="20dp" />

        <TextView
            android:id="@+id/btnLoadPlay"
            style="@style/AIStream.FocusItem"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:text="立即播放"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="等全部线路就绪自动进入 · 急着看按确认键直接播"
            android:textColor="@color/fg_dim"
            android:textSize="14sp" />

    </LinearLayout>

</FrameLayout>
