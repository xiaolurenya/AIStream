<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（图1 参考样式）：顶部分类标签栏 + 中间大海报 hero + 右边推荐列，下面按栏目一行行排。
     hero 背景跟页面同色通铺（不再垫 bg_card）—— 海报上下颜色连成一片，没有色差断层。
     hero 支持直播预览小窗：导航轨「电视直播」卡聚焦/设置开了就直接播。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingTop="24dp" android:clipChildren="false">

    <!-- 顶部分类标签栏：首页 + 服务器配的各栏目，点了滚到对应那一行（60dp 容下加大的 chip） -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad" android:clipChildren="false">

        <!-- 中：大海报 hero（可切直播预览小窗），背景跟页面同色 -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" android:clipChildren="false">

            <!-- v1.4.22 补底层（代码驱动，默认 gone）：
                 竖版海报 → 填「海报左缘取色 → 页面底色」的横向渐变，补满左侧空档（取色不是模糊）；
                 横版图 → 整幅铺满（清晰原图 centerCrop）。两种都消灭「只有半边」 -->
            <ImageView
                android:id="@+id/heroBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_scrim_left" />

            <!-- v1.4.22 竖版海报本体：右侧原比例完整清晰展示（不裁人物、不拉伸、不模糊），
                 左侧空档由 heroBg 的环境色渐变衔接成整幅画面，标题/立即播放照旧在左下 -->
            <ImageView
                android:id="@+id/heroPoster"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="end|center_vertical"
                android:adjustViewBounds="true"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter" />

            <!-- 直播预览小窗：盖在海报上，只有预览时可见。
                 ⚠️ 必须用 TextureView（默认 SurfaceView 在一批盒子/投影上 surface 位置
                 不跟着布局走：预览一开画面「钉」在原地，下面的栏目行从它上面滚过去，
                 叠成图2 那个鬼样子；TextureView 是普通 View，跟布局/缩放/滚动走） -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/heroPv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                app:surface_type="texture_view"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/liveInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_pad"
                android:paddingBottom="20dp"
                android:visibility="gone" android:clipChildren="false">

                <TextView
                    android:id="@+id/tvLiveName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveEpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFD5D9E4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLiveHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:text="按确认键全屏观看"
                    android:textColor="#FFE8EEF9"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:paddingBottom="@dimen/page_pad">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/hero_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/fg_dim"
                    android:textSize="@dimen/hero_meta" />

                <TextView
                    android:id="@+id/btnPlay"
                    style="@style/AIStream.FocusItem"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/hero_btn_h"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:paddingStart="28dp"
                    android:paddingEnd="28dp"
                    android:text="@string/play_now"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/hero_btn_text"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical|center_horizontal"
                android:orientation="horizontal"
                android:clipChildren="false" />

        </FrameLayout>

        <!-- 右：推荐列（取服务器首页第一栏最前面几张）。
             v1.4.16：clipChildren=false —— 焦点卡放大后描边可完整画出不被 RecyclerView
             裁掉（之前描边被裁得缺一块，看着「边框位置不对」） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSide"
            android:layout_width="@dimen/side_rv"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="16dp"
        android:paddingBottom="24dp" />

</LinearLayout>
