<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（图1 样式）：左边功能卡列 + 中间大海报 hero + 右边推荐列，下面按栏目一行行排。
     hero 支持直播预览小窗：焦点落在「电视直播」卡上就播当前台，
     确认键进全屏直播，焦点离开恢复海报。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:orientation="horizontal"
        android:paddingStart="24dp"
        android:paddingTop="16dp"
        android:paddingEnd="24dp">

        <!-- 左：功能卡列 -->
        <LinearLayout
            android:layout_width="176dp"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cardLive"
                style="@style/AIStream.FocusItem"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_side_live"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:paddingStart="18dp"
                android:paddingEnd="12dp"
                android:text="📺 电视直播"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardFav"
                style="@style/AIStream.FocusItem"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_side_fav"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:paddingStart="18dp"
                android:paddingEnd="12dp"
                android:text="❤ 我的收藏"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cardHis"
                style="@style/AIStream.FocusItem"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_side_his"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:lineSpacingExtra="3dp"
                android:maxLines="2"
                android:paddingStart="18dp"
                android:paddingEnd="12dp"
                android:text="⏱ 观看历史"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- 中：大海报 hero（可切直播预览小窗） -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:background="@color/bg_card">

            <ImageView
                android:id="@+id/heroBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_scrim_left" />

            <View
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_scrim_bottom" />

            <!-- 直播预览小窗：盖在海报上，只有预览时可见 -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/heroPv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/liveInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLiveName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveEpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFD5D9E4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLiveHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="按确认键全屏观看 · 移开焦点关闭预览"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:paddingBottom="24dp">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#CC000000"
                    android:shadowRadius="6"
                    android:textColor="@android:color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/fg_dim"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/btnPlay"
                    style="@style/AIStream.FocusItem"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:text="@string/play_now"
                    android:textColor="@android:color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingEnd="28dp" />

        </FrameLayout>

        <!-- 右：推荐列（取服务器首页第一栏最前面几张） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSide"
            android:layout_width="160dp"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="10dp"
        android:paddingBottom="24dp" />

</LinearLayout>
