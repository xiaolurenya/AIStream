<?xml version="1.0" encoding="utf-8"?>
<!-- 首页（图1 参考样式）：顶部分类标签栏 + 中间大海报 hero + 右边推荐列，下面按栏目一行行排。
     hero 背景跟页面同色通铺（不再垫 bg_card）—— 海报上下颜色连成一片，没有色差断层。
     hero 支持直播预览小窗：导航轨「电视直播」卡聚焦/设置开了就直接播。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <!-- 顶部分类标签栏：首页 + 服务器配的各栏目，点了滚到对应那一行 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTabs"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/hero_height"
        android:orientation="horizontal"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad">

        <!-- 中：大海报 hero（可切直播预览小窗），背景跟页面同色 -->
        <FrameLayout
            android:id="@+id/hero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/heroBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="centerCrop" />

            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_scrim_left" />

            <!-- 直播预览小窗：盖在海报上，只有预览时可见 -->
            <androidx.media3.ui.PlayerView
                android:id="@+id/heroPv"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/liveInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_pad"
                android:paddingBottom="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvLiveName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLiveEpg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFD5D9E4"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvLiveHint"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="按确认键全屏观看 · 移开焦点关闭预览"
                    android:textColor="@color/fg_dim"
                    android:textSize="13sp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:paddingStart="@dimen/page_pad"
                android:paddingEnd="@dimen/page_pad"
                android:paddingBottom="@dimen/page_pad">

                <TextView
                    android:id="@+id/heroTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:shadowColor="#F0000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="8"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/hero_title"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/heroMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/fg_dim"
                    android:textSize="@dimen/hero_meta" />

                <TextView
                    android:id="@+id/btnPlay"
                    style="@style/AIStream.FocusItem"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/hero_btn_h"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/bg_btn"
                    android:gravity="center"
                    android:paddingStart="30dp"
                    android:paddingEnd="30dp"
                    android:text="@string/play_now"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/hero_btn_text"
                    android:textStyle="bold" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/heroDots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginBottom="32dp"
                android:gravity="center_vertical|end"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/page_pad" />

        </FrameLayout>

        <!-- 右：推荐列（取服务器首页第一栏最前面几张） -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSide"
            android:layout_width="@dimen/side_rv"
            android:layout_height="match_parent"
            android:layout_marginStart="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingTop="4dp"
        android:paddingBottom="24dp" />

</LinearLayout>
