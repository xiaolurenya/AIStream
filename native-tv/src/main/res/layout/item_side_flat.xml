<?xml version="1.0" encoding="utf-8"?>
<!-- 首页右侧推荐卡（参考 base.apk 扁横排样式）：小海报在左 + 片名/播放提示在右。
     ID 跟 item_poster 保持一致（card/img/tvTitle/tvSub/tvBadge），复用 PosterAdapter.H。
     v1.4.15：边框收小——海报占比加大（54x64）、左右内边距收紧（6/10dp）、
     卡间距 8→6dp，整列更紧凑，不再一圈大蓝框（大哥图5 点名） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card"
    style="@style/AIStream.FocusItem"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="6dp"
    android:paddingEnd="10dp" android:clipChildren="false">

    <ImageView
        android:id="@+id/img"
        android:layout_width="54dp"
        android:layout_height="64dp"
        android:contentDescription="@string/app_name"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical" android:clipChildren="false">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/fg"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="▶ 立即播放"
            android:textColor="@color/accent_soft"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- 占位：侧栏卡不用角标，保持 ID 复用 -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
