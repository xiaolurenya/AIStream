<?xml version="1.0" encoding="utf-8"?>
<!-- TV 直播：画面铺满，按左键/菜单键叫出左侧频道单，上下键选台、确认键播放 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black" android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="56dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="@dimen/live_title"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tvErr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="36dp"
        android:textColor="@color/fg_dim"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chPanel"
        android:layout_width="@dimen/chpanel_w"
        android:layout_height="match_parent"
        android:background="@drawable/bg_chpanel"
        android:foreground="@drawable/bg_shadow_r"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="14dp"
        android:visibility="gone" android:clipChildren="false">

        <!-- 面板标题行（v1.4.10 压缩）：原来标题 20sp + 提示行 + 关闭钮叠三层，
             投影上一挤内容都看不清；现在单行 16sp，提示行删掉（操作自己会） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp" android:clipChildren="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="频道列表"
                android:textColor="@color/fg"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClosePanel"
                style="@style/AIStream.FocusItem"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:background="@drawable/bg_search"
                android:gravity="center"
                android:nextFocusDown="@id/etSearch"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="✕ 关闭"
                android:textColor="@color/fg"
                android:textSize="12sp" />

        </LinearLayout>

        <!-- 节目单（v1.4.10 从面板底部挪上来）：原来钉在最底下，台名后面正在播的节目
             经常被截断看不见；现在紧跟标题，一眼就是「当前台 + 正在播」。
             v1.4.13：壳加 id（量可用宽用壳宽）；整体下移 6dp（大哥点名再往下一点）；
             TextView 改 wrap_content，判定不依赖布局宽度 -->
        <FrameLayout
            android:id="@+id/flEpgNowBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tvEpgNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#FFD9A441"
                android:textSize="13sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/flEpgNextBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tvEpgNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/fg_dim"
                android:textSize="12sp" />

        </FrameLayout>

        <!-- 搜索频道名（别人家的直播面板有这玩意，确实好用）。
             UP 明确指到关闭按钮：不然焦点搜索会被标题文字块/左侧分组列搅混，关闭按钮选不到 -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_search"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:hint="搜索频道名…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:nextFocusUp="@id/btnClosePanel"
            android:nextFocusDown="@id/rvCh"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_dim"
            android:textSize="13sp" />

        <!-- 参照样式两栏：左边分组竖列（后台是什么列表就是什么列表），右边频道列表。
             v1.4.12：列表顶部留 6dp 并恢复裁剪（clipToPadding 默认 true）——
             频道多快速下翻时行不会再顶到搜索框（大哥图3 点名） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:orientation="horizontal" android:clipChildren="false">

            <!-- ⚠️ ScrollView 默认自己可聚焦且没有任何视觉反馈，D-pad 上下导航时它会在旁边
                 「隐形截胡」，焦点到不了关闭按钮/分组列（大哥说的「关闭按钮选不到」元凶之一）。
                 禁掉它自己的焦点，真正的焦点目标是里面的分组 TextView。 -->
            <ScrollView
                android:id="@+id/scCats"
                android:layout_width="@dimen/chcat_w"
                android:layout_height="match_parent"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/llCats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" android:clipChildren="false" />

            </ScrollView>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="12dp"
                android:background="#33FFFFFF" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvCh"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:paddingTop="6dp"
                android:overScrollMode="never" />

        </LinearLayout>

        <!-- （v1.4.10 底部节目单已挪到标题下方：底下这截在投影上经常被截断，
             台名后面的节目名显示不全——大哥点名换位置） -->

    </LinearLayout>

</FrameLayout>
