<?xml version="1.0" encoding="utf-8"?>
<!-- TV 直播：画面铺满，按左键/菜单键叫出左侧频道单，上下键选台、确认键播放 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black" android:clipChildren="false">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginTop="32dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowRadius="6"
        android:textColor="@android:color/white"
        android:textSize="@dimen/live_title"
        android:textStyle="bold" />

    <ProgressBar
        android:id="@+id/pb"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tvErr"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:padding="36dp"
        android:textColor="@color/fg_dim"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/chPanel"
        android:layout_width="@dimen/chpanel_w"
        android:layout_height="match_parent"
        android:background="#F20C1F3F"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp"
        android:visibility="gone" android:clipChildren="false">

        <!-- 面板标题行：触摸用户点 × 关闭（遥控器按返回/左键也能关） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="10dp" android:clipChildren="false">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="频道"
                android:textColor="@color/fg"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnClosePanel"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="#33FFFFFF"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="✕ 关闭"
                android:textColor="@color/fg"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- 搜索频道名（别人家的直播面板有这玩意，确实好用） -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="#26FFFFFF"
            android:hint="搜索频道名…"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_dim"
            android:textSize="14sp" />

        <!-- 分类筛选条：全部 7135 ｜ 央视频 73 ｜ IPTV 470 …（分组从直播源自动来） -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none" android:clipChildren="false">

            <LinearLayout
                android:id="@+id/llCats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"  android:clipChildren="false" />

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <!-- 底部节目单：正在播的是哪个台播什么、接下来播什么 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#33FFFFFF" />

        <TextView
            android:id="@+id/tvEpgNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFD9A441"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvEpgNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/fg_dim"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>
