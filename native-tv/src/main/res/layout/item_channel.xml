<?xml version="1.0" encoding="utf-8"?>
<!-- 选台行：三位编号（圆角小方块）+ 台标 + 台名/正在播节目。
     v1.4.14：台名/节目名换 MarqueeTextView 自绘裁剪跑马灯（View 恒在名字区内，
     自绘 clipRect 裁剪，绝不遮挡编号/台标；每轮自动重量宽适配台标异步加载）。
     v1.4.12 的「外层 FrameLayout 裁剪壳」方案已废弃删除 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    style="@style/AIStream.FocusItem"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp" android:clipChildren="false">

    <!-- 三位编号：半透明圆角小方块，金色字更醒目 -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_num"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvNum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- 台标容器：加 id，频道没台标/台标加载失败时在 Adapter 里整个 GONE，文字不留空位 -->
    <FrameLayout
        android:id="@+id/flLogo"
        android:layout_width="@dimen/ch_logo_w"
        android:layout_height="@dimen/ch_logo_h"
        android:layout_marginEnd="8dp" android:clipChildren="false">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" android:clipChildren="false">

        <!-- v1.4.14：台名/节目名换 MarqueeTextView（自绘裁剪跑马灯）。
             View 恒 match_parent（=名字区宽）永不出界，onDraw 里 clipRect+translate 自绘，
             文字滚到哪都被裁在自己边界内 —— 物理上不可能再盖住台标/前面编号（大哥图3/图4 点名）；
             每轮滚回开头自动重量宽，台标异步加载挤压名字区也不怕行程错 -->
        <io.github.xiaolurenya.aistream.tvbox.MarqueeTextView
            android:id="@+id/tvName"
            style="@style/AIStream.TextTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp" />

        <io.github.xiaolurenya.aistream.tvbox.MarqueeTextView
            android:id="@+id/tvEpg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/fg_dim"
            android:textSize="11sp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
