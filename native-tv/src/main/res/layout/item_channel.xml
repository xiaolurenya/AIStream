<?xml version="1.0" encoding="utf-8"?>
<!-- 选台行：三位编号（圆角小方块）+ 台标 + 台名/正在播节目。
     v1.4.12：台名/节目名改自定义跑马灯（MarqueeLabel 统一调度，translationX 平移），
     外面套 FrameLayout 负责裁剪滚动的文字；系统 marquee 已弃用 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    style="@style/AIStream.FocusItem"
    android:layout_width="match_parent"
    android:layout_height="54dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/bg_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="10dp"
    android:paddingBottom="6dp" android:clipChildren="false">

    <!-- 三位编号：半透明圆角小方块，金色字更醒目 -->
    <FrameLayout
        android:layout_width="30dp"
        android:layout_height="26dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/bg_num"
        android:clipChildren="false">

        <TextView
            android:id="@+id/tvNum"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- 台标容器：加 id，频道没台标/台标加载失败时在 Adapter 里整个 GONE，文字不留空位 -->
    <FrameLayout
        android:id="@+id/flLogo"
        android:layout_width="@dimen/ch_logo_w"
        android:layout_height="@dimen/ch_logo_h"
        android:layout_marginEnd="8dp" android:clipChildren="false">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical" android:clipChildren="false">

        <!-- 裁剪壳：跑马灯文字在壳内平移，超出部分被壳裁掉。
             v1.4.13：壳加 id（MarqueeLabel 量可用宽用壳宽，不再用 match_parent 的 tv 宽），
             TextView 改 wrap_content（自身宽度=文字宽，判定永不依赖布局宽度） -->
        <FrameLayout
            android:id="@+id/flNameBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tvName"
                style="@style/AIStream.TextTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textSize="13sp" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/flEpgBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:clipChildren="true">

            <TextView
                android:id="@+id/tvEpg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="@color/fg_dim"
                android:textSize="11sp"
                android:visibility="gone" />

        </FrameLayout>

    </LinearLayout>

</LinearLayout>
