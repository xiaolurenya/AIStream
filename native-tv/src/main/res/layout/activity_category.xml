<?xml version="1.0" encoding="utf-8"?>
<!-- 分类海报网格页（顶部分类标签点进来）：标题 + 海报网格，D-pad 挑一张进详情。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:paddingStart="@dimen/page_pad"
    android:paddingTop="44dp"
    android:paddingBottom="20dp"
    android:paddingEnd="@dimen/page_pad" android:clipChildren="false">

    <!-- 标题行：品牌色竖条 + 栏目名，比光秃秃一行字更有精气神 -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <View
            android:layout_width="5dp"
            android:layout_height="24dp"
            android:background="@color/accent" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="@color/fg"
            android:textSize="26sp"
            android:textStyle="bold" />

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="10dp"
        android:clipToPadding="false"
        android:layoutAnimation="@anim/anim_grid"
        android:overScrollMode="never" />

</LinearLayout>
