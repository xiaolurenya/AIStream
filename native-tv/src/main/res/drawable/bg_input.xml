<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页输入框。v1.4.25 两处改动：
     ① 圆角 14→10dp，与 bg_focus_ring 对齐（原环比框圆角大，描边四角翘到框外出圈）；
     ② 聚焦环画进背景 layer-list，不再只靠 bindFocus 的 foreground 环 ——
        onCreate 里就 requestFocus 的视图会在 0×0 时拿到焦点环，foreground 的 bounds
        退化，整环退化成「框顶一根直线、圆角被切平」（大哥截图实测）。背景 bounds
        由框架按视图尺寸管理，不可能退化。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF182B52" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.5dp" android:color="#8CFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF182B52" />
                    <corners android:radius="10dp" />
                    <stroke android:width="1.5dp" android:color="#8CFFFFFF" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <stroke android:width="2dp" android:color="#FFFFFFFF" />
                    <corners android:radius="10dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF102140" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
        </shape>
    </item>
</selector>
