<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页输入框：聚焦时底色亮一档 + 描边提亮，配合 bindFocus 的白描边环双重点名。
     v1.4.25：圆角 14→10dp，与 bg_focus_ring 对齐 —— 之前环比框圆角大（14>10），
     描边的圆角弧比输入框小，四角翘到输入框轮廓外，就是大哥截图点名的「选中框出圈」。
     改可聚焦控件的圆角必须和 bg_focus_ring 同步，这是血泪定式。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF182B52" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF182B52" />
            <corners android:radius="10dp" />
            <stroke android:width="1.5dp" android:color="#8CFFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF102140" />
            <corners android:radius="10dp" />
            <stroke android:width="1dp" android:color="#29FFFFFF" />
        </shape>
    </item>
</selector>
